PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
TOMI_BACKEND_URL=http://127.0.0.1:8080
TOMI_PUBLIC_ORIGIN=http://localhost:3000
TOMI_WEB_IMAGE_TAG=dev

# Optional verification scripts. Select an existing audio file and a new receipt path.
CANVAS_TEST_ORIGIN=http://localhost:3000
DIARIZATION_TEST_ORIGIN=http://localhost:3000
DIARIZATION_TEST_AUDIO=replace-with-audio-file.wav
DIARIZATION_TEST_RECEIPT=.runtime/diarization-receipt.json

# Optional secret scanner override: docker or container (Apple Container); blank auto-detects.
TOMI_CONTAINER_ENGINE=
